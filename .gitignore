node_modules/
dist/

# ONNX Runtime binaries, copied from node_modules at build time by
# scripts/copy-ort.mjs. Reproducible artefacts; 39 MB of WASM does not belong
# in the history.
public/ort/
public/zxing/

# Development TLS material. The private keys must never be committed; the
# README explaining how they are generated should be.
certs/*
!certs/README.md

*.local

# Test build artefacts (esbuild output for the unit suites).
.tmp/
tests/.tmp/
# Screenshots written by the browser suites as a side effect.
shot-*.png
tests/**/*.png
.DS_Store
