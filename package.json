{
  "name": "tricorder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run copy-wasm && vite",
    "dev:lan": "vite --host",
    "build": "npm run copy-wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "serve-ca": "bash scripts/serve-ca.sh",
    "certs": "bash scripts/make-certs.sh",
    "copy-wasm": "node scripts/copy-ort.mjs && node scripts/copy-zxing.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "zxing-wasm": "^3.1.3"
  }
}
