# Tricorder — Apache config for a DreamHost static deploy.

# ---- MIME types ---------------------------------------------------------
# ONNX Runtime instantiates its WebAssembly with the streaming compiler, which
# REQUIRES application/wasm. Apache does not know .wasm by default, serves it
# as text/plain, and the failure is a compile error deep inside the runtime
# rather than a 404 — so this line is what makes Depth and Analyze work at all.
AddType application/wasm .wasm
AddType text/javascript .mjs
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# ---- Compression --------------------------------------------------------
# .wasm and .woff2 are deliberately absent: both are already compressed, and
# re-compressing costs CPU to make them very slightly larger.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---- Caching ------------------------------------------------------------
<IfModule mod_headers.c>
  # Vite fingerprints everything under /assets/, so those are immutable.
  <FilesMatch "\.(js|mjs|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The ONNX runtime binaries are versioned by their directory, not by hash,
  # so they get a long cache but stay revalidatable.
  <FilesMatch "\.wasm$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # index.html must never be cached: it is what points at the fingerprinted
  # bundles, so a stale copy pins the whole app to an old deploy.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# NOTE: no Cross-Origin-Embedder-Policy. It would enable SharedArrayBuffer and
# multi-threaded WASM, but it also blocks the cross-origin model download from
# huggingface.co unless that host sends CORP headers — which it does not. The
# app runs its models on WebGPU, so the trade is not worth taking.

# ---- Directory listing --------------------------------------------------
Options -Indexes
